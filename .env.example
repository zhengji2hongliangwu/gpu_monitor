# 数据库配置
DATABASE_DIR=/gpu_monitor/data
DATABASE_PATH=/gpu_monitor/data/metrics.db

# 日志配置
LOG_DIR=/gpu_monitor/logs
LOG_FILE=/gpu_monitor/logs/server_used_rate.log

# 服务配置
HOST=0.0.0.0
PORT=8010
DEBUG=False

# 数据采集配置
COLLECTION_INTERVAL=5
REALTIME_DATA_MAX_COUNT=60

# 数据保留策略
DATA_RETENTION_DAYS=395
DATABASE_MAX_SIZE_MB=20000
AUTO_CLEANUP_ENABLED=true
CLEANUP_INTERVAL_HOURS=24

# GPU 配置
GPU_COLLECTOR_TYPE=nvidia-smi
